{
  "name": "busybar-world-clock",
  "private": true,
  "version": "0.1.0",
  "description": "Switch between named clocks with fixed UTC offsets.",
  "author": "iMalkav",
  "license": "MIT",
  "keywords": [
    "busy-bar",
    "javascript-app",
    "clock-time",
    "world-clock"
  ],
  "type": "module",
  "scripts": {
    "metadata": "node scripts/metadata.mjs",
    "typecheck": "tsc -b",
    "test": "node --test tests/model.test.ts tests/common.test.ts",
    "build": "node scripts/prepare.mjs && busy-cli build --emit both --bundle",
    "smoke": "node tests/smoke.mjs",
    "check": "pnpm metadata && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "release": "pnpm check && node scripts/release.mjs",
    "app:install": "busy-cli app install",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "app:uninstall": "busy-cli app uninstall"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@busy-app/cli": "0.6.0",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@busy-app/busy-lib": "0.21.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iMalkav/busybar-world-clock.git"
  },
  "homepage": "https://github.com/iMalkav/busybar-world-clock#readme",
  "bugs": {
    "url": "https://github.com/iMalkav/busybar-world-clock/issues"
  }
}
